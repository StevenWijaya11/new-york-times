{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["src/app/types"],
    "baseUrl": ".",
    "paths": {
      "@test/*": ["__tests__/*"],
      "@app/*": ["src/app/*"],
      "@core/*": ["src/core/*"],
      "@resources/*": ["src/resources/*"],
      "@ui/*": ["src/ui/*"],
      "@utils/*": ["src/utils/*"],
    }
  }
}
